{
  "rewrites": [
    { "source": "/c/:code", "destination": "/index.html" },
    { "source": "/book", "destination": "/book.html" },
    { "source": "/api/:path*", "destination": "https://paveroffer.zapreplacement.workers.dev/api/:path*" }
  ],
  "headers": [
    {
      "source": "/c/:code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
